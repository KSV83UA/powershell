@{
    # =====================================================================
    #  Описание инфраструктуры для Stop-Servers.ps1
    #
    #  Это ПРИМЕР. Скопируйте его в infrastructure.psd1 и впишите свои серверы:
    #      Copy-Item .\infrastructure.example.psd1 .\infrastructure.psd1
    #  infrastructure.psd1 в git не попадает (.gitignore): репозиторий публичный,
    #  а в файле адреса и логины серверов.
    #
    #  Адреса 192.0.2.x ниже — документационные (TEST-NET), они никуда не ведут.
    #  Сохраняйте файл в UTF-8 с BOM, иначе PowerShell 5.1 испортит кириллицу.
    # =====================================================================

    # Описание инфраструктуры — выводится в .\Stop-Servers.ps1 -List
    Description = 'Офис: серверная, ИБП 3 кВА. При пропадании питания серверы гасятся этим скриптом.'

    # --- Порядок и ожидание ---
    # Серверы выключаются очередями (Stage у сервера): сначала все серверы очереди 1, скрипт ждёт,
    # пока они перестанут отвечать, затем очередь 2 и т.д.
    # Сколько ждать выключения серверов одной очереди (сек). Потом — следующая очередь в любом случае.
    StageTimeoutSec = 300
    # Как часто проверять, выключился ли сервер (сек)
    PollIntervalSec = 5

    # --- Linux (и Windows с OpenSSH Server): подключение по SSH с ключом, без пароля ---
    # Пользователь по умолчанию. Для root команда выключения — 'shutdown -h now',
    # для остальных — 'sudo -n shutdown -h now' (нужен sudo без пароля, см. README).
    SshUser = 'root'
    SshPort = 22
    # Закрытый ключ. Пусто — стандартные ключи пользователя, от которого запущен скрипт (~\.ssh\id_*).
    # Можно использовать %USERPROFILE% и другие переменные окружения.
    SshKeyFile = ''
    # Свой known_hosts рядом со скриптом: ключи серверов запоминаются при первом подключении
    # и одинаково работают из-под любой учётной записи. Пусто — ~\.ssh\known_hosts.
    SshKnownHostsFile = 'known_hosts'
    # Таймаут подключения SSH (сек)
    SshConnectTimeoutSec = 10

    # --- Windows ---
    # Способ по умолчанию: WMI (Stop-Computer по DCOM) | WinRM (Stop-Computer по WS-Man) | SSH
    WindowsMethod = 'WMI'
    # Общие учётные данные администратора Windows (обычно доменный: ДОМЕН\пользователь).
    # Создаётся командой .\Stop-Servers.ps1 -SaveCredential.
    # Если файла нет — используются права пользователя, от которого запущен скрипт (удобно в домене).
    # Серверу не из домена или с другим администратором задайте свой CredentialFile (пример — BACKUP ниже).
    CredentialFile = 'windows.cred.xml'

    # Папка логов. Относительные пути здесь и ниже — от папки с этим файлом.
    LogDirectory = 'logs'

    # =====================================================================
    #  Серверы
    #
    #  Обязательные параметры:
    #    Name     — имя (для вывода и ключа -Name)
    #    Address  — IP-адрес или DNS-имя
    #    OS       — Windows | Linux
    #    Stage    — очередь выключения: 1 — первыми, чем больше число, тем позже
    #
    #  Необязательные:
    #    Role, Notes    — описание: что за сервер, что на нём работает, где стоит
    #    Enabled        — $false: сервер есть в описании, но скрипт его не выключает
    #    Method         — переопределить способ (Windows: WMI | WinRM | SSH; Linux: только SSH)
    #    User, Port, KeyFile — переопределить SshUser / SshPort / SshKeyFile. Только для SSH:
    #                     у Windows по WMI/WinRM учётка берётся из CredentialFile, а не из User
    #                     (для Windows с Method = 'SSH' User обязателен — администратор Windows)
    #    Command        — своя команда выключения для SSH (например, для NAS или гипервизора)
    #    CredentialFile — свой файл учётных данных для этого сервера Windows (не в домене или
    #                     другой администратор). Создаётся: .\Stop-Servers.ps1 -SaveCredential -Name <Name>
    #
    #  Компьютер, на котором запускается скрипт, в список не включайте:
    #  выключив его, скрипт оборвётся на середине.
    # =====================================================================
    Servers = @(
        # --- Очередь 1: то, с чем работают пользователи ---
        @{
            Name    = 'RDS1'
            Address = '192.0.2.11'
            OS      = 'Windows'
            Stage   = 1
            Role    = 'Терминальный сервер (RDP), клиенты 1С'
            Notes   = 'Сеансы пользователей завершаются принудительно'
        }
        @{
            Name    = 'APP1C'
            Address = '192.0.2.12'
            OS      = 'Windows'
            Stage   = 1
            Role    = 'Сервер приложений 1С:Предприятие'
        }

        # --- Очередь 2: базы данных и файлы — после того как приложения закрыли соединения ---
        @{
            Name    = 'DB1'
            Address = '192.0.2.21'
            OS      = 'Linux'
            Stage   = 2
            Role    = 'PostgreSQL для 1С'
            Notes   = 'Ubuntu 22.04'
            User    = 'admin'       # не root -> выключается через sudo -n shutdown -h now
        }
        @{
            Name    = 'FILES'
            Address = '192.0.2.22'
            OS      = 'Windows'
            Stage   = 2
            Role    = 'Файловый сервер'
            Method  = 'WinRM'       # пример: этот сервер выключается по WinRM, а не по WMI
        }
        @{
            Name    = 'BACKUP'
            Address = '192.0.2.23'
            OS      = 'Windows'
            Stage   = 2
            Role    = 'Сервер резервного копирования'
            Notes   = 'Не в домене, свой администратор'
            # Своя учётка вместо общей. Создать: .\Stop-Servers.ps1 -SaveCredential -Name BACKUP
            # Имя вводить как BACKUP\Administrator — имя компьютера сервера и пользователь.
            CredentialFile = 'backup.cred.xml'
        }

        # --- Очередь 3: хранилища и гипервизоры — в самом конце ---
        @{
            Name    = 'NAS'
            Address = '192.0.2.31'
            OS      = 'Linux'
            Stage   = 3
            Role    = 'Сетевое хранилище, резервные копии'
            User    = 'admin'
            Port    = 2222
            Command = 'sudo -n /sbin/poweroff'
            Enabled = $false        # пока выключаем вручную
        }
        @{
            Name    = 'PVE1'
            Address = '192.0.2.32'
            OS      = 'Linux'
            Stage   = 3
            Role    = 'Гипервизор Proxmox VE'
            Notes   = 'Свои виртуальные машины при выключении гасит сам'
        }
    )
}
