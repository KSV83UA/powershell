# Настройки для Backup-UserProfiles.ps1.
# Пути пишутся в одинарных кавычках как есть, обратную косую черту удваивать не нужно.
# Перед запуском скрипт проверяет этот файл и при ошибках ничего не копирует.
# Проверить настройки без копирования:  .\Backup-UserProfiles.ps1 -WhatIf
@{
    # Откуда копировать: папка с профилями, полный путь.
    # Локальная 'C:\Users' или через админ-шару '\\RDS01\C$\Users'.
    ProfilesRoot = 'C:\Users'

    # Куда складывать бэкап, полный путь: 'D:\ProfileBackup' или '\\NAS\Backup\RDS01'.
    # Внутри будет создана папка на каждого пользователя.
    BackupRoot = ''

    # Профили, которые копировать не нужно: имена папок из ProfilesRoot, можно с * и ?.
    # По одному имени на строку, запятые не нужны.
    ExcludeUser = @(
        # системные и служебные
        'Public'
        'Default'
        'Default User'
        'All Users'
        'defaultuser*'
        'TEMP'
        'TEMP.*'
        '.NET v*'
        'MSSQL*'
        # свои, например:
        # 'Administrator'
        # 'Администратор'
    )

    # Если нужны только некоторые профили, перечислите их здесь (по умолчанию - все).
    # User = @('ivanov', 'petrov*')

    # Папки и файлы, которые не попадают в архив. Скрытое и системное (NTUSER.DAT и т.п.)
    # пропускается и без этого списка. Список действует на все профили.
    # Каждая запись - путь относительно корня профиля (не полный!), можно с * и ?;
    # звёздочка заменяет любое число символов, включая \.
    Exclude = @(
        # папки в корне профиля
        'AppData'
        'Searches'
        'Links'
        'Saved Games'
        '3D Objects'
        'MicrosoftEdgeBackups'
        'IntelGraphicsProfiles'
        '.*'
        # вложенные папки и файлы, например:
        # 'Documents\Outlook Files'   - одна вложенная папка
        # 'Downloads\*.iso'           - файлы по маске в папке и её подпапках
        # '*\Cache'                   - папка Cache на любой глубине, кроме корня
        # '*.tmp'                     - файлы по маске где угодно
    )

    # Что взять в архив, даже если оно лежит в исключённой папке (например, в AppData).
    # Точный путь к файлу или папке относительно корня профиля, без масок.
    # У кого такого файла нет, для того запись просто не срабатывает.
    Include = @(
        # список баз 1С
        'AppData\Roaming\1C\1CEStart\ibases.v8i'
    )

    # Сжатие: 'Optimal' - меньше размер, 'Fastest' - быстрее, 'NoCompression' - без сжатия.
    CompressionLevel = 'Optimal'
}
